generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  Shopify
  WordPress
}


model Customer {
  id            String   @id
  name          String
  email         String   @unique
  avatar        String?
  platform      Platform
  status        String   @default("Active")
  registeredAt  DateTime
  popupOpens       Int      @default(0)
  popupCloses      Int      @default(0)
  popupSuccess     Int      @default(0)
  popupRejection   Int      @default(0)
  videoUrlDesktop  String?
  videoUrlMobile   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
